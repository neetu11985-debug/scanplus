# No secrets needed for the demo. Only the optional Neon adapter loads .env.
SCANPLUS_MODE=demo
PORT=4173
# Live mode deliberately fails closed. No production credentials belong here.
# Configurable, bounded retention in seconds (synthetic state only):
SCANPLUS_SESSION_TTL=900
SCANPLUS_CHALLENGE_TTL=300
SCANPLUS_PAYMENT_TTL=86400
# Local demo defaults to .data/scanplus-demo.sqlite3.
# A host must confirm a private writable path with SQLite locking before deployment.
# SCANPLUS_DB_PATH=/absolute/private/path/scanplus-demo.sqlite3
# HTTPS WSGI requires explicit comma-separated origins; no trailing slash:
# SCANPLUS_ALLOWED_ORIGINS=https://your-chosen-product-domain.example
# Synthetic history outlives sessions to test a seven-day return/refund journey.
# This is not real financial retention or customer authentication.
SCANPLUS_DEMO_HISTORY_TTL=691200

# Separate local self-test only. Nothing is enabled or configured here.
# Application does not load this file. Never put credential values in source.
# SCANPLUS_LOCAL_LIVE_TEST=1
# SCANPLUS_SEARCH_PROVIDER=serper
# Required provider variable names and secure setup prerequisites: LOCAL_LIVE_TEST.md

# Separate Stripe sandbox page /stripe-test. Disabled unless explicitly configured.
# Environment only; this example is not automatically loaded. Never commit keys.
SCANPLUS_STRIPE_TEST=0
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must come from private environment.
# Only test-mode secret keys are accepted. Live mode remains blocked.
# SCANPLUS_STRIPE_ORIGIN=http://127.0.0.1:4173
# See STRIPE_TEST.md for separate owner setup, webhook and test limitations.

# Optional Neon encrypted-storage adapter. Never commit populated values.
# These are injected by the reviewed deployment, not generated by the app.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SCANPLUS_STORAGE_KEYS_JSON=
SCANPLUS_STORAGE_ACTIVE_VERSION=
SCANPLUS_NEON_SMOKE=0

# Render defaults to private disposable demo. See COMPLETION_HANDOFF.md before
# choosing sandbox; it enables real Stripe TEST API calls and synthetic Neon writes.
SCANPLUS_RELEASE_PROFILE=demo
SCANPLUS_ENCRYPTED_REPORTS=0
